{
  "name": "fow-cache",
  "version": "0.1.0",
  "description": "How often does your semantic cache serve the wrong answer? A benchmark, a CI check and a guard for multi-turn chats, built on Jev.",
  "keywords": [
    "llm",
    "semantic-cache",
    "benchmark",
    "evaluation",
    "caching",
    "jev",
    "langchain"
  ],
  "author": "Mabon ap Gwyn",
  "license": "MIT",
  "homepage": "https://github.com/Maby0/fow-cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maby0/fow-cache.git",
    "directory": "js"
  },
  "bugs": "https://github.com/Maby0/fow-cache/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fow-cache": "bin/fow-cache.js"
  },
  "files": [
    "bin",
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "npm run sync && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60",
    "@langchain/core": ">=0.3"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@langchain/core": "^1.2.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
